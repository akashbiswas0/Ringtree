{
  "name": "ringtree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:broker\" \"npm:web\"",
    "web": "vite --host 127.0.0.1 --port 3000",
    "broker": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "ringlink": "tsx scripts/ringlink.ts",
    "setup": "tsx scripts/setup.ts",
    "agent": "tsx scripts/agent.ts",
    "aws": "tsx scripts/aws.ts",
    "remote:prepare": "tsx scripts/remote-prepare.ts",
    "remote:check": "tsx scripts/remote-check.ts",
    "requeue:executor": "tsx scripts/requeue-executor.ts",
    "graph:codegen": "yarn --cwd subgraph codegen",
    "graph:build": "yarn --cwd subgraph build",
    "graph:test": "yarn --cwd subgraph test",
    "graph:deploy": "yarn --cwd subgraph deploy",
    "start": "tsx server/main.ts"
  },
  "dependencies": {
    "@bunli/utils": "0.6.0",
    "@graphprotocol/client-x402": "^1.0.0",
    "@ledgerhq/context-module": "2.5.0",
    "@ledgerhq/device-management-kit": "1.9.0",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.0",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@ledgerhq/hw-ledger-key-ring-protocol": "0.10.7",
    "@ledgerhq/ledger-key-ring-protocol": "0.15.2",
    "@napi-rs/keyring": "^1.2.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "ethers": "6.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "graphql": "^16.11.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "viem": "^2.56.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ethers": "6.17.0",
    "ws": "8.21.3",
    "uuid": "11.1.1",
    "axios": "1.20.0",
    "@ledgerhq/speculos-transport": "0.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
